# Copy this file to .env and fill in real values.
# server.js loads it from $HOME/billing-app/backend/.env

NODE_ENV=production
PORT=3001
HTTPS_PORT=3443

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/billing_db?retryWrites=true&w=majority

# JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=replace_me_with_a_long_random_hex_string
JWT_EXPIRES_IN=8h

APP_NAME=Gold Jewellery Billing

# Optional: live gold rate API key
GOLDPRICEZ_API_KEY=YOUR_KEY_HERE
